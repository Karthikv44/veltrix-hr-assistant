# Veltrix PeopleOps Assistant - Environment Configuration
# Data directory mounts and paths (defaults point to ./data)
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
APP_DB_PATH=./app.db

# Today's reference date override (YYYY-MM-DD). If unset or empty, system date is used.
APP_TODAY=2026-09-15

# LLM Provider Configuration
# NOTE: Current implementation supports ONLY the Google Gemini client.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Google Gemini API Key (leave blank in version control; supply your own at runtime)
# Set either GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=
GOOGLE_API_KEY=

# (Reserved for future multi-provider extensions; currently unused/unsupported)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Chroma Vector Store Persistence Directory (stored locally inside container)
CHROMA_DIR=./chroma_db

# Feature Flags & Behavior Settings
LLM_CACHE_ENABLED=true
CITE_CALENDAR_IN_TOOL_ROUTE=false
LOG_LEVEL=INFO
FAST_EMBED_MODEL=BAAI/bge-small-en-v1.5
